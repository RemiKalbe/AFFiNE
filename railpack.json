{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22",
    "rust": "1.92.0"
  },
  "caches": {
    "yarn": {
      "directory": "/usr/local/share/.cache/yarn",
      "type": "shared"
    },
    "cargo": {
      "directory": "/root/.cargo/registry",
      "type": "shared"
    }
  },
  "buildAptPackages": [
    "openssl",
    "python3",
    "build-essential",
    "clang",
    "libssl-dev",
    "pkg-config"
  ],
  "steps": {
    "install": {
      "commands": [{ "cmd": "corepack enable" }, { "cmd": "yarn install" }],
      "caches": ["yarn"]
    },
    "build-native": {
      "inputs": [{ "step": "install" }],
      "commands": [
        {
          "cmd": "yarn workspace @affine/server-native build --target x86_64-unknown-linux-gnu"
        }
      ],
      "caches": ["cargo"],
      "variables": {
        "CC": "clang -D_BSD_SOURCE",
        "TARGET_CC": "clang -D_BSD_SOURCE"
      }
    },
    "build": {
      "inputs": [{ "step": "build-native" }],
      "commands": [
        { "cmd": "yarn affine @affine/web build" },
        { "cmd": "yarn affine @affine/admin build" },
        { "cmd": "yarn workspace @affine/server build" },
        {
          "cmd": "cp -r packages/frontend/apps/web/dist packages/backend/server/static"
        },
        {
          "cmd": "cp -r packages/frontend/admin/dist packages/backend/server/static/admin"
        }
      ],
      "deployOutputs": [{ "include": ["packages/**", "node_modules/**"] }]
    }
  },
  "deploy": {
    "aptPackages": ["openssl", "libjemalloc2"],
    "startCommand": "node packages/backend/server/dist/main.js",
    "variables": {
      "LD_PRELOAD": "libjemalloc.so.2",
      "NODE_ENV": "production"
    }
  }
}
